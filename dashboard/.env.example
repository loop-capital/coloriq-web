DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coloriq?schema=public"

REDIS_URL=redis://localhost:6379
UPLOOK_API_KEY=
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
MODERATION_API_KEY=
# --- Monthly creator-tier recalc (Vercel Cron, 1st of month) ---
# Bearer token the cron job sends as Authorization header. Generate with:
#   openssl rand -base64 32
# Set the same value in the Vercel env dashboard (Production). CRON_SECRET
# must be non-empty in production or the endpoint only accepts admin JWTs.
CRON_SECRET=

# --- OpenAI (two-key split) ---
# OPENAI_API_KEY: legacy single key — used as fallback for both below.
# OPENAI_ASSISTANT_KEY: voice assistant Q&A + consultation dictation (gpt-4o-mini).
# OPENAI_VISION_KEY: photo hair analysis (vision-capable model).
# Set ASSISTANT/VISION separately for isolated spend + rate limits (separate
# OpenAI projects recommended). Either may be omitted to fall back to OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_ASSISTANT_KEY=
OPENAI_VISION_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
