/// One monthly per-use billing statement for a stylist, aggregating
/// formula_usage_log rows for that period. Line items are stored as JSON
/// (mirrors the mock's BillingLineItem[] shape) rather than a child table,
/// since they're a point-in-time snapshot, not queried independently.
model formula_billing_invoices {
  id                           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Billing is scoped to the salon (matching formula_usage_log.salonId and
  // formula_purchases.salonId — a license/usage is the salon's, not one
  // stylist's) — this was previously stylist_id, pointed at users.id (the
  // wrong id space entirely; stylist_id has a real FK to stylists.id), and
  // never actually matched the scope everything else in this system uses.
  salon_id                     String              @db.Uuid
  billing_period               String              @db.VarChar(7)
  line_items                   Json
  total_cents                  Int
  total_creator_earnings_cents Int
  total_platform_fee_cents     Int
  // Voice assistant cost has no creator split (100% platform pass-through,
  // unlike formula usage) — tracked separately for invoice transparency
  // rather than folded into the marketplace earnings/fee fields.
  voice_assistant_cents        Int?                @default(0)
  status                       String              @default("pending") @db.VarChar(20)
  paid_at                      DateTime?
  square_payment_id            String?
  failure_reason               String?
  created_at                   DateTime            @default(now())
  salon                        salons              @relation(fields: [salon_id], references: [id])
  usage_events                 formula_usage_log[]
  voice_assistant_usage        voice_assistant_usage[]

  @@unique([salon_id, billing_period], map: "uniq_formula_billing_invoice_period")
  @@index([status], map: "idx_formula_billing_invoices_status")
}

// Manual creator payouts — Square has no product for automatically sending
// money out to many independent third parties (it's a one-merchant tool,
// not a marketplace-payout platform like Stripe Connect). This tracks what
// each creator is actually owed (computed from formula_usage_log for usage
// that's been successfully billed and collected from the paying salon) and
// records that Jason paid it manually (Venmo/Zelle/ACH/check — his choice),
// rather than fabricating an automated transfer that doesn't exist.
model creator_payouts {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id       String    @db.Uuid
  billing_period   String    @db.VarChar(7)
  total_cents      Int
  status           String    @default("pending") @db.VarChar(20)
