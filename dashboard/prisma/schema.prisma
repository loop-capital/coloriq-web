generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model analyses {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id          String?   @db.Uuid
  level              Int?      @default(1)
  tone               String?   @default("natural")
  underlying_pigment String?
  rgb_r              Int?      @default(0)
  rgb_g              Int?      @default(0)
  rgb_b              Int?      @default(0)
  confidence         Int?      @default(80)
  image_url          String?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  clients            clients?  @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model api_keys {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_type            String    @db.VarChar(20)
  owner_id              String    @db.Uuid
  key_hash              String    @unique @db.VarChar(255)
  key_prefix            String    @db.VarChar(8)
  scopes                String[]
  last_used_at          DateTime? @db.Timestamp(6)
  usage_count           Int?      @default(0)
  rate_limit_per_minute Int?      @default(300)
  is_active             Boolean?  @default(true)
  expires_at            DateTime? @db.Timestamp(6)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  created_by            String?   @db.Uuid
  stylists              stylists? @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([key_hash], map: "idx_api_keys_hash")
  @@index([owner_type, owner_id], map: "idx_api_keys_owner")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model brands {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String          @unique @db.VarChar(100)
  slug              String          @unique @db.VarChar(100)
  manufacturer      String?         @db.VarChar(100)
  manufacturer_code String?         @db.VarChar(20)
  origin_country    String?         @db.VarChar(2)
  website_url       String?
  support_phone     String?         @db.VarChar(50)
  support_email     String?         @db.VarChar(255)
  tier              String?         @db.VarChar(20)
  professional_only Boolean?        @default(true)
  features          String[]
  logo_url          String?
  brand_colors      String[]
  is_active         Boolean?        @default(true)
  launch_date       DateTime?       @db.Date
  discontinued_date DateTime?       @db.Date
  created_at        DateTime?       @default(now()) @db.Timestamp(6)
  updated_at        DateTime?       @default(now()) @db.Timestamp(6)
  developers        developers[]
  product_lines     product_lines[]

  @@index([slug], map: "idx_brands_slug")
  @@index([tier], map: "idx_brands_tier")
}

model clients {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name          String                   @db.VarChar(100)
  last_name           String                   @db.VarChar(100)
  email               String?                  @db.VarChar(255)
  phone               String?                  @db.VarChar(50)
  date_of_birth       DateTime?                @db.Date
  gender              String?                  @db.VarChar(20)
  primary_stylist_id  String?                  @db.Uuid
  salon_id            String?                  @db.Uuid
  hair_profile        Json?                    @default("{\"density\": null, \"texture\": null, \"porosity\": \"normal\", \"natural_tone\": null, \"natural_level\": null, \"scalp_condition\": \"normal\"}")
  allergies_legacy           Json?                    @default("{\"ppd\": false, \"other\": [], \"ammonia\": false, \"fragrance\": false}")
  medications         String[]
  conditions          String[]
  preferences         Json?                    @default("{\"budget_range\": null, \"disliked_tones\": [], \"preferred_brands\": [], \"maintenance_level\": \"medium\", \"reminders_enabled\": true, \"communication_method\": \"text\"}")
  total_visits        Int?                     @default(0)
  last_visit_at       DateTime?                @db.Timestamp(6)
  next_appointment_at DateTime?                @db.Timestamp(6)
  lifetime_value      Decimal?                 @default(0) @db.Decimal(10, 2)
  general_notes       String?
  formula_notes       String?
  marketing_consent   Boolean?                 @default(false)
  consent_updated_at  DateTime?                @db.Timestamp(6)
  created_at          DateTime?                @default(now()) @db.Timestamp(6)
  updated_at          DateTime?                @default(now()) @db.Timestamp(6)
  search_vector       Unsupported("tsvector")?
  portal_enabled      Boolean?                 @default(true)
  portal_last_viewed  DateTime?                @db.Timestamp(6)
  portal_token        String?                  @unique @db.VarChar(32)
  portal_view_count   Int?                     @default(0)
  square_customer_id  String?                  @db.VarChar(255)
  analyses            analyses[]
  client_portals      client_portals[]
  client_visits       client_visits[]
  stylists            stylists?                @relation(fields: [primary_stylist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salons              salons?                  @relation(fields: [salon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formula_photos      formula_photos[]
  formulas            formulas[]
  formulations        formulations[]
  photo_analyses      photo_analyses[]
  stylist_feedback    stylist_feedback[]
  visits              visits[]
  patch_tests         client_patch_tests[]
  allergy_records     client_allergies[]

  @@index([last_visit_at], map: "idx_clients_last_visit")
  @@index([salon_id], map: "idx_clients_salon")
  @@index([search_vector], map: "idx_clients_search", type: Gin)
  @@index([primary_stylist_id], map: "idx_clients_stylist")
  @@index([primary_stylist_id, last_visit_at(sort: Desc)], map: "idx_clients_stylist_lookup")
  @@index([square_customer_id], map: "idx_clients_square_customer_id")
}

/// Schema-only table: currently has ZERO writers in the codebase
/// (no code inserts/updates; verified by grep). Keep the table and
/// migrations; wire up writers when real color-extraction output exists.
model color_extractions {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id          String         @db.Uuid
  level                Int?
  level_confidence     Decimal?       @db.Decimal(4, 3)
  level_distribution   Decimal[]      @db.Decimal(4, 3)
  primary_tone         String?        @db.Char(2)
  secondary_tone       String?        @db.Char(2)
  tone_confidence      Decimal?       @db.Decimal(4, 3)
  rgb                  Int[]
  lab                  Float[]
  hex                  String?        @db.VarChar(7)
  undertone            String?        @db.VarChar(20)
  undertone_confidence Decimal?       @db.Decimal(4, 3)
  extracted_from       String?        @db.VarChar(20)
  created_at           DateTime?      @default(now()) @db.Timestamp(6)
  photo_analyses       photo_analyses @relation(fields: [analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([analysis_id], map: "idx_color_extractions_analysis")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model developers {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id               String?                  @db.Uuid
  name                   String                   @db.VarChar(100)
  volume                 Int
  h2o2_percentage        Decimal?                 @db.Decimal(4, 2)
  viscosity              String?                  @db.VarChar(20)
  special_properties     String[]
  compatible_lines       String[]                 @db.Uuid
  cost_per_oz            Decimal?                 @db.Decimal(5, 2)
  is_active              Boolean?                 @default(true)
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  brands                 brands?                  @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formulation_components formulation_components[]

  @@unique([brand_id, volume])
  @@index([brand_id], map: "idx_developers_brand")
  @@index([volume], map: "idx_developers_volume")
}

model formula_history {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formulation_id  String       @db.Uuid
  change_type     String       @db.VarChar(50)
  changed_by      String?      @db.Uuid
  previous_values Json?
  new_values      Json?
  change_reason   String?
  created_at      DateTime?    @default(now()) @db.Timestamp(6)
  stylists        stylists?    @relation(fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formulations    formulations @relation(fields: [formulation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([change_type], map: "idx_formula_history_change_type")
  @@index([changed_by], map: "idx_formula_history_changed_by")
  @@index([created_at(sort: Desc)], map: "idx_formula_history_created_at")
  @@index([formulation_id], map: "idx_formula_history_formulation")
}

model formula_outcomes {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formulation_id         String       @db.Uuid
  actual_level           Int?
  actual_tone            String?      @db.VarChar(10)
  level_match            Boolean?
  tone_match             Boolean?
  color_match            Boolean?
  delta_e                Decimal?     @db.Decimal(5, 2)
  client_satisfaction    Int?
  would_return           Boolean?
  gray_coverage_achieved Int?
  lift_achieved          Int?
  condition_change       String?      @db.VarChar(20)
  service_price          Decimal?     @db.Decimal(6, 2)
  product_cost           Decimal?     @db.Decimal(5, 2)
  longevity_weeks        Int?
  fading_notes           String?
  created_at             DateTime?    @default(now()) @db.Timestamp(6)
  formulations           formulations @relation(fields: [formulation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([formulation_id], map: "idx_formula_outcomes_formulation")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model formulas {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stylist_id       String?            @db.Uuid
  client_id        String?            @db.Uuid
  shade_id         String?            @db.Uuid
  name             String?
  developer_vol    Int?               @default(20)
  mixing_ratio     String?            @default("1:1.5")
  processing_time  Int?               @default(30)
  notes            String?
  product_brand    String?
  product_line     String?
  product_shade    String?
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @default(now()) @db.Timestamptz(6)
  client_visits    client_visits[]
  formula_photos   formula_photos[]
  clients          clients?           @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shades           shades?            @relation(fields: [shade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users?             @relation(fields: [stylist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visits           visits[]
  formula_listings formula_listings[]
}

model formulation_components {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formulation_id   String       @db.Uuid
  component_type   String       @db.VarChar(20)
  shade_id         String?      @db.Uuid
  developer_id     String?      @db.Uuid
  brand            String?      @db.VarChar(50)
  product_line     String?      @db.VarChar(100)
  shade_code       String?      @db.VarChar(20)
  developer_volume Int?
  amount_oz        Decimal?     @db.Decimal(5, 2)
  amount_ml        Decimal?     @db.Decimal(6, 2)
  amount_ratio     Decimal?     @db.Decimal(3, 2)
  purpose          String?      @db.VarChar(50)
  sequence_order   Int?
  created_at       DateTime?    @default(now()) @db.Timestamp(6)
  developers       developers?  @relation(fields: [developer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formulations     formulations @relation(fields: [formulation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shades           shades?      @relation(fields: [shade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([formulation_id], map: "idx_formulation_components_formulation")
  @@index([component_type], map: "idx_formulation_components_type")
}

model formulations {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stylist_id              String                   @db.Uuid
  client_id               String?                  @db.Uuid
  current_analysis_id     String?                  @db.Uuid
  target_analysis_id      String?                  @db.Uuid
  input_data              Json                     @default("{}")
  action_type             String?                  @db.VarChar(50)
  brand                   String?                  @db.VarChar(50)
  product_line            String?                  @db.VarChar(100)
  target_level            String?
  target_tone             String?
  primary_formula         Json                     @default("{}")
  toning_formula          Json?
  processing_instructions Json                     @default("{}")
  validation              Json?
  confidence_score        Decimal?                 @db.Decimal(4, 3)
  cost_estimate           Decimal?                 @db.Decimal(6, 2)
  suggested_price         Decimal?                 @db.Decimal(6, 2)
  status                  String?                  @default("generated") @db.VarChar(20)
  outcome_id              String?                  @db.Uuid
  learning_adjusted       Boolean?                 @default(false)
  regional_trend_id       String?                  @db.Uuid
  created_at              DateTime?                @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                @default(now()) @db.Timestamp(6)
  formula_history         formula_history[]
  formula_outcomes        formula_outcomes[]
  formulation_components  formulation_components[]
  clients                 clients?                 @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stylists                stylists                 @relation(fields: [stylist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stylist_feedback        stylist_feedback[]

  transformations transformations[]
  photo_analyses        photo_analyses[]
  @@index([action_type], map: "idx_formulations_action_type")
  @@index([brand], map: "idx_formulations_brand")
  @@index([client_id], map: "idx_formulations_client")
  @@index([created_at(sort: Desc)], map: "idx_formulations_created_at")
  @@index([input_data], map: "idx_formulations_input_data", type: Gin)
  @@index([primary_formula], map: "idx_formulations_primary_formula", type: Gin)
  @@index([processing_instructions], map: "idx_formulations_processing", type: Gin)
  @@index([product_line], map: "idx_formulations_product_line")
  @@index([status], map: "idx_formulations_status")
  @@index([stylist_id], map: "idx_formulations_stylist")
  @@index([stylist_id, created_at(sort: Desc)], map: "idx_formulations_stylist_date")
}

/// Schema-only table: currently has ZERO writers in the codebase
/// (no code inserts/updates; verified by grep). Keep the table and
/// migrations; wire up writers when real segmentation output exists.
model hair_segmentations {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id         String         @db.Uuid
  full_mask_url       String?
  root_mask_url       String?
  mid_mask_url        String?
  end_mask_url        String?
  coverage_percentage Decimal?       @db.Decimal(5, 2)
  hair_pixel_count    Int?
  confidence          Decimal?       @db.Decimal(4, 3)
  created_at          DateTime?      @default(now()) @db.Timestamp(6)
  photo_analyses      photo_analyses @relation(fields: [analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([analysis_id], map: "idx_hair_segmentations_analysis")
}

model learning_events {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type           String    @db.VarChar(50)
  stylist_id           String?   @db.Uuid
  salon_id             String?   @db.Uuid
  region               String?   @db.VarChar(50)
  event_data           Json      @default("{}")
  model_version        String?   @db.VarChar(50)
  training_data_points Int?
  accuracy_before      Decimal?  @db.Decimal(4, 3)
  accuracy_after       Decimal?  @db.Decimal(4, 3)
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  salons               salons?   @relation(fields: [salon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stylists             stylists? @relation(fields: [stylist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_learning_events_created_at")
  @@index([event_type], map: "idx_learning_events_type")
}

model photo_analyses {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stylist_id              String?              @db.Uuid
  client_id               String?              @db.Uuid
  photo_type              String               @db.VarChar(20)
  photo_label             String?              @db.VarChar(50)
  // Phase 1 item 5: real pairing references at capture. photo_label keeps
  // carrying the raw sessionId string (existing callers, incl. client-side
  // capture uids, still rely on it); session_id is the FK and is set only
  // when the supplied sessionId resolves to a formulation_sessions row.
  // formulation_id is the generated formulation (formulations.id) supplied
  // as formulaId at upload, or null when no formula context exists.
  session_id              String?              @db.Uuid
  formulation_id          String?              @db.Uuid
  original_url            String
  processed_url           String?
  mask_url                String?
  original_size           Int[]
  file_size_bytes         Int?
  format                  String?              @db.VarChar(10)
  processing_status       String?              @default("pending") @db.VarChar(20)
  processing_started_at   DateTime?            @db.Timestamp(6)
  processing_completed_at DateTime?            @db.Timestamp(6)
  processing_time_ms      Int?
  lighting_corrected      Boolean?             @default(false)
  original_color_temp     Int?
  corrections_applied     String[]
  results                 Json?
  error_message           String?
  model_versions          Json?
  created_at              DateTime?            @default(now()) @db.Timestamp(6)
  color_extractions       color_extractions[]
  hair_segmentations      hair_segmentations[]
  clients                 clients?             @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stylists                stylists?            @relation(fields: [stylist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formulation_sessions    formulation_sessions? @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formulations            formulations?         @relation(fields: [formulation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  texture_analyses        texture_analyses[]

  @@index([client_id], map: "idx_photo_analyses_client")
  @@index([created_at(sort: Desc)], map: "idx_photo_analyses_created_at")
  @@index([processing_status], map: "idx_photo_analyses_status")
  @@index([stylist_id], map: "idx_photo_analyses_stylist")
  @@index([photo_type], map: "idx_photo_analyses_type")
  @@index([session_id], map: "idx_photo_analyses_session")
  @@index([formulation_id], map: "idx_photo_analyses_formulation")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_lines {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand_id                    String    @db.Uuid
  name                        String    @db.VarChar(100)
  code                        String?   @unique @db.VarChar(20)
  slug                        String    @db.VarChar(100)
  color_type                  String    @db.VarChar(50)
  ammonia_free                Boolean?  @default(false)
  plex_technology             String?   @db.VarChar(50)
  alkaline_agent              String?   @db.VarChar(20)
  ph_level                    Decimal?  @db.Decimal(3, 1)
  max_gray_coverage           Int?
  max_lift_levels             Int?
  mixing_ratio                String    @db.VarChar(10)
  developer_options           Int[]
  requires_specific_developer Boolean?  @default(false)
  base_processing_time        Int?
  max_processing_time         Int?
  can_use_heat                Boolean?  @default(true)
  usage_instructions          String?
  contraindications           String[]
  image_urls                  Json?
  is_active                   Boolean?  @default(true)
  launch_date                 DateTime? @db.Date
  discontinued_date           DateTime? @db.Date
  created_at                  DateTime? @default(now()) @db.Timestamp(6)
  updated_at                  DateTime? @default(now()) @db.Timestamp(6)
  brands                      brands    @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shades                      shades[]

  @@unique([brand_id, name])
  @@index([brand_id], map: "idx_product_lines_brand")
  @@index([slug], map: "idx_product_lines_slug")
  @@index([color_type], map: "idx_product_lines_type")
}

model regional_trends {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  region               String    @db.VarChar(50)
  season               String?   @db.VarChar(10)
  year                 Int?
  trend_type           String?   @db.VarChar(50)
  trend_name           String?   @db.VarChar(100)
  formulation_count    Int?      @default(0)
  average_satisfaction Decimal?  @default(0) @db.Decimal(3, 2)
  growth_rate          Decimal?  @db.Decimal(5, 2)
  popular_levels       Int[]
  popular_tones        String[]
  popular_brands       String[]
  trend_start_date     DateTime? @db.Date
  trend_peak_date      DateTime? @db.Date
  trend_end_date       DateTime? @db.Date
  is_active            Boolean?  @default(true)
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)

  @@index([trend_name], map: "idx_regional_trends_name")
  @@index([region], map: "idx_regional_trends_region")
  @@index([season, year], map: "idx_regional_trends_season")
  @@index([trend_type], map: "idx_regional_trends_trend_type")
}

model salons {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String                   @db.VarChar(200)
  slug                    String                   @unique @db.VarChar(200)
  invite_code             String?                  @unique @db.VarChar(12)
  address_line1           String?                  @db.VarChar(200)
  address_line2           String?                  @db.VarChar(200)
  city                    String?                  @db.VarChar(100)
  state                   String?                  @db.VarChar(2)
  postal_code             String?                  @db.VarChar(20)
  country                 String?                  @default("US") @db.VarChar(2)
  latitude                Decimal?                 @db.Decimal(10, 8)
  longitude               Decimal?                 @db.Decimal(11, 8)
  timezone                String?                  @default("America/New_York") @db.VarChar(50)
  phone                   String?                  @db.VarChar(50)
  email                   String?                  @db.VarChar(255)
  website                 String?                  @db.VarChar(255)
  business_type           String?                  @db.VarChar(50)
  pricing_tier            String?                  @db.VarChar(20)
  subscription_tier       String?                  @default("salon") @db.VarChar(20)
  subscription_seats      Int?                     @default(5)
  subscription_expires_at DateTime?                @db.Timestamp(6)
  features_enabled        Json?                    @default("{\"analytics\": true, \"api_access\": false, \"multi_location\": false, \"inventory_management\": false}")
  preferred_brands        String[]
  active_stylists         Int?                     @default(0)
  total_clients           Int?                     @default(0)
  monthly_formulations    Int?                     @default(0)
  settings                Json?                    @default("{}")
  created_at              DateTime?                @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                @default(now()) @db.Timestamp(6)
  formulaBudget           Decimal?                 @default(0) @db.Decimal(10, 2)
  salon_pin               String?                  @db.VarChar(255)
  salon_pin_set           Boolean?                 @default(false)
  trusted_stylists        String[]
  // Card on file for monthly per-use formula license billing — captured
  // once via a real small verification charge (Square Checkout can't save
  // a card without a real payment), then reused every month without any
  // further checkout redirect.
  square_customer_id      String?                  @db.VarChar(255)
  square_card_id          String?                  @db.VarChar(255)
  billing_card_last4      String?                  @db.VarChar(4)
