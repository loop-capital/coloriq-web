// on their own account first (their Settings > Developers > APIs &
// Webhooks), which Vagaro approves on a 5-7 business day turnaround. This
// isn't a connect-now flow like Square/Clover; it's connect-once-approved.
model vagaro_connections {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salon_id                String    @unique @db.Uuid
  business_id             String?   @db.VarChar(255)
