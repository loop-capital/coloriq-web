/// A formula listed for sale/license on the marketplace. Distinct from `formulas`
/// (a technical record of what was mixed for one client visit) — a listing is the
/// commerce/discovery wrapper a creator publishes, optionally derived from one.
/// Replaces two disconnected, never-reconciled mock prototypes
/// (lib/api/mock-data.ts's separate `templates[]` and `formulas[]` arrays, with
/// two different and incompatible tier-pricing schemes) with one real model.
/// Each listing carries its own concrete prices rather than a tier->price lookup
/// table, which is what let the original mock crash (formula.tier values never
/// matched TIER_PRICING's keys).
model formula_listings {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id        String                    @db.Uuid
  source_formula_id String?                   @db.Uuid
  title             String                    @db.VarChar(200)
  description       String?
  category          String                    @db.VarChar(100)
  tags              String[]                  @default([])
  tier              String                    @db.VarChar(20)
  score             Int                       @default(50)
  price_cents       Int                       @default(0)
  per_use_cents     Int                       @default(0)
  photo_url         String?
  share_code        String?                   @unique @db.VarChar(20)
  rating            Decimal?                  @default(0) @db.Decimal(3, 2)
  review_count      Int                       @default(0)
  purchase_count    Int                       @default(0)
  usage_count       Int                       @default(0)
  is_active         Boolean                   @default(true)
  created_at        DateTime                  @default(now())
  updated_at        DateTime                  @default(now())
  creator           stylists                  @relation(fields: [creator_id], references: [id])
  source_formula    formulas?                 @relation(fields: [source_formula_id], references: [id])
  purchases         formula_purchases[]
  usage_log         formula_usage_log[]
  client_requests   formula_client_requests[]

  transformations transformations[]
  @@index([category], map: "idx_formula_listings_category")
  @@index([creator_id], map: "idx_formula_listings_creator")
  @@index([is_active], map: "idx_formula_listings_active")
}

