  updated_at          DateTime? @default(now()) @db.Timestamp(6)
  salon               salons    @relation(fields: [salon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_zenoti_connections_status")
}

// API-Key + SiteId is the accessible path (self-serve from a Mindbody
// developer account); full OAuth exists but requires contacting Mindbody
// support to provision an OAuth client, so it isn't wired here.
model mindbody_connections {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salon_id            String    @unique @db.Uuid
  site_id             String?   @db.VarChar(255)
  api_key_encrypted   String?
  business_name       String?   @db.VarChar(255)
  status              String    @default("disconnected") @db.VarChar(20)
  last_sync_at        DateTime? @db.Timestamp(6)
  sync_error          String?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
  salon               salons    @relation(fields: [salon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_mindbody_connections_status")
}

// Short-lived pairing between the iPad running Color Bar and a stylist's
// own phone — the iPad generates a code, the phone claims it, and the
// phone's photo->AI formula flow links its resulting session back to this
// code so the iPad can pick it up and jump straight into weighing.
model colorbar_pairing_codes {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique @db.VarChar(8)
  salon_id   String    @db.Uuid
  status     String    @default("waiting") @db.VarChar(20) // waiting | claimed | linked | expired
  claimed_by String?   @db.Uuid
  session_id String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  salon      salons    @relation(fields: [salon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([salon_id], map: "idx_colorbar_pairing_codes_salon")
  @@index([code], map: "idx_colorbar_pairing_codes_code")
}

model formula_queue {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salon_id       String    @db.Uuid
  stylist_id     String    @db.Uuid
  client_name    String    @db.VarChar(255)
  brand          String    @db.VarChar(100)
  shades         Json
  developer_vol  Int?
  total_grams    Decimal?  @db.Decimal(8, 2)
  formula_result Json?
  status         String    @default("pending") @db.VarChar(20)
  queue_position Int       @default(0)
  device_code    String?   @db.VarChar(4)
  weighed_grams  Decimal?  @db.Decimal(8, 2)
  completed_at   DateTime? @db.Timestamptz(6)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  salons         salons    @relation(fields: [salon_id], references: [id], onDelete: Cascade)
  stylists       stylists  @relation(fields: [stylist_id], references: [id])

  @@index([device_code, status], map: "idx_fq_device")
  @@index([salon_id, device_code, queue_position], map: "idx_fq_position")
  @@index([salon_id], map: "idx_fq_salon")
  @@index([status], map: "idx_fq_status")
  @@index([stylist_id], map: "idx_fq_stylist")
}

/// Reconciled against the live DB 2026-09-17 — schema.prisma had drifted in
/// both directions: device_code/feedback_submitted_at/updated_at were
/// declared here but don't actually exist (writing updated_at, as the
/// session-creation route did, would throw a real Postgres error); 5 real
/// live columns (square_order_id, quality_rating, adjustments,
/// result_photo_url, was_adjusted) were missing entirely; salon_id/
/// stylist_id are NOT NULL live but were declared nullable here.
model color_bar_sessions {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salon_id                    String    @db.Uuid
  stylist_id                  String    @db.Uuid
  client_id                   String?   @db.Uuid
  formula_id                  String?   @db.Uuid
  status                      String?   @default("active") @db.VarChar(20)
  steps                       Json?
  total_cost                  Decimal?  @db.Decimal
  square_order_id             String?   @db.VarChar
  created_at                  DateTime? @default(now()) @db.Timestamptz(6)
  completed_at                DateTime? @db.Timestamptz(6)
  quality_rating              Int?
  adjustments                 Json?
  result_photo_url            String?
  was_adjusted                Boolean?  @default(false)
  feedback_submitted          Boolean?  @default(false)
  feedback_rating             Int?
  feedback_notes              String?
  feedback_converted_to_brand Boolean?  @default(false)
  feedback_used_for_training  Boolean?  @default(false)

  @@index([salon_id], map: "idx_color_bar_sessions_salon")
  @@index([stylist_id], map: "idx_color_bar_sessions_stylist")
  @@index([client_id], map: "idx_color_bar_sessions_client")
  @@index([status], map: "idx_color_bar_sessions_status")
}

/// Formula memory — real target-vs-actual grams per client+shade, from
/// either surface that weighs a formula (Color Bar iPad or the web
/// Formulate page). This is what lets us suggest a smaller/adjusted mix
/// size next time, the same way Vish's bowl-reweigh feature does. One row
/// per ingredient per completed weighing, not an aggregate — aggregation
/// happens at read time in lib/formula-memory.ts so the averaging window
/// can change without a backfill.
model formula_outcome_history {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id    String   @db.Uuid
  brand        String   @db.VarChar(100)
  shade_code   String   @db.VarChar(50)
  target_grams Decimal  @db.Decimal(10, 2)
  actual_grams Decimal  @db.Decimal(10, 2)
  source       String   @db.VarChar(20) // 'color_bar' | 'web_formulate'
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([client_id, brand, shade_code], map: "idx_formula_outcome_history_lookup")
}

/// Transformation journey: licensed starting formula -> AI-personalized
/// formulation -> before/after photos -> published post. Born as a draft at
/// formulation time so the full chain exists by construction. Lifecycle:
/// draft -> enriched -> published. Publishing requires a separate marketing
/// consent record; the draft's existence never implies posting permission.
model transformations {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stylist_id         String            @db.Uuid
  status             String            @default("draft") @db.VarChar(20)
  source_formula_id  String?           @db.Uuid
  formulation_id     String            @db.Uuid
  before_photo_ref   String            @db.VarChar(1000)
  after_photo_ref    String?           @db.VarChar(1000)
  shade_story        String?
  shades             Json?
  client_consent     Json?
  published_post_ref String?           @db.VarChar(500)
  created_at         DateTime          @default(now()) @db.Timestamp(6)
  enriched_at        DateTime?         @db.Timestamp(6)
  published_at       DateTime?         @db.Timestamp(6)
  stylist            stylists          @relation(fields: [stylist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source_formula     formula_listings? @relation(fields: [source_formula_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formulation        formulations      @relation(fields: [formulation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([stylist_id], map: "idx_transformations_stylist")
  @@index([status], map: "idx_transformations_status")
  @@index([source_formula_id], map: "idx_transformations_source_formula")
  @@index([formulation_id], map: "idx_transformations_formulation")
}

/// Client patch test records — safety/compliance tracking for color services.
/// A current (non-expired) passing test is required before applying oxidative color.
model client_patch_tests {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id     String    @db.Uuid
  salon_id      String?   @db.Uuid
  test_date     DateTime  @db.Date
  product_brand String?   @db.VarChar(100)
  product_shade String?   @db.VarChar(50)
  result        String    @db.VarChar(20)
  notes         String?
  tested_by     String?   @db.Uuid
  expiry_date   DateTime? @db.Date
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  client        clients   @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_id], map: "idx_patch_tests_client")
  @@index([client_id, test_date(sort: Desc)], map: "idx_patch_tests_client_date")
}

/// Client allergy records — flagged allergens trigger warnings on the client
/// record and when creating formulas containing the allergen.
model client_allergies {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id   String    @db.Uuid
  allergen    String    @db.VarChar(100)
  severity    String    @db.VarChar(20)
  notes       String?
  recorded_by String?   @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  client      clients   @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_id], map: "idx_client_allergies_client")
}

/// Formula accuracy tracking — how well AI/predicted formulas perform in the
/// real world. Feeds marketing claims and the model-improvement flywheel.
/// Records with accuracy below threshold are flagged for retraining review.
model formula_accuracy {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  formulation_id   String?   @db.Uuid
  formula_id       String?   @db.Uuid
  client_id        String?   @db.Uuid
  stylist_id       String?   @db.Uuid
  salon_id         String?   @db.Uuid
  service_type     String?   @db.VarChar(50)
  predicted_level  Int?
  actual_level     Int?
  predicted_tone   String?   @db.VarChar(50)
  actual_tone      String?   @db.VarChar(50)
  outcome          String    @db.VarChar(20)
  rating           Int?
  adjustment_notes String?
  needs_retraining Boolean?  @default(false)
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([formulation_id], map: "idx_formula_accuracy_formulation")
  @@index([salon_id], map: "idx_formula_accuracy_salon")
  @@index([salon_id, created_at(sort: Desc)], map: "idx_formula_accuracy_salon_date")
  @@index([service_type], map: "idx_formula_accuracy_service")
}

// COLORiq Emergency Triage — permanent liability record of every triage session
model triage_sessions {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salon_id      String?   @db.Uuid
  stylist_id    String?   @db.Uuid
  client_id     String?   @db.Uuid
  client_name   String?   @db.VarChar(200)
  risk_grade    String    @db.VarChar(20)
  symptoms      String[]
  triage_input  Json?
  risk_triggers String[]
  recovery_plan Json?
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([salon_id], map: "idx_triage_salon")
  @@index([salon_id, created_at(sort: Desc)], map: "idx_triage_salon_date")
  @@index([risk_grade], map: "idx_triage_grade")
  @@index([client_id], map: "idx_triage_client")
}
